    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE EXTENSION IF NOT EXISTS vector SCHEMA public;\nCREATE EXTENSION IF NOT EXISTS pgcrypto;\n\nCREATE TABLE IF NOT EXISTS public.documentos_unab (\n  id bigserial PRIMARY KEY,\n  content text,\n  metadata jsonb,\n  embedding public.vector(3072)\n);\n\nDROP INDEX IF EXISTS documentos_unab_embedding_idx;\nALTER TABLE public.documentos_unab ALTER COLUMN embedding TYPE public.vector(3072);\n\nCREATE INDEX IF NOT EXISTS idx_documentos_unab_metadata\n  ON public.documentos_unab USING gin (metadata);",
        "options": {}
      },
